{
  "name": "pixelagents-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "plugins/*", "examples/hello-plugin"],
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @pixelagents/server",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
